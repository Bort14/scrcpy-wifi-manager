<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ScrcpyWifiManager</AssemblyName>
    <RootNamespace>ScrcpyWifiManager</RootNamespace>
    <ApplicationIcon>Assets\ScrcpyWifiManager.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
  </PropertyGroup>
  <ItemGroup>
    <Content Remove="wwwroot\**\*" />
    <EmbeddedResource Include="wwwroot\**\*" LogicalName="ScrcpyWifiManager.Web.%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\logo.svg" LogicalName="ScrcpyWifiManager.Web.logo.svg" />
  </ItemGroup>
  <Target Name="RemoveUnusedStaticWebAssetsManifest" AfterTargets="Publish">
    <Delete Files="$(PublishDir)$(AssemblyName).staticwebassets.endpoints.json" />
  </Target>
</Project>
